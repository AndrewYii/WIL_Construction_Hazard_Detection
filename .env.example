# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Where the Ollama server lives. On the Spark itself this is usually
# localhost, but set the port explicitly if your instance doesn't use the
# 11434 default.
OLLAMA_HOST=http://localhost:11434

# Uncomment to override the model preference chains (first model pulled on
# the server wins). Defaults live in app/config.py.
# REPORT_MODELS=gpt-oss:120b,gemma4:31b,qwen3:32b,llama3.3:70b,llava:7b
# VLM_MODELS=gemma4:26b,qwen3.6:35b-a3b-bf16,qwen2.5vl:32b,gemma3:27b,llava:7b

# Uncomment to change the dashboard's port (default 8090).
# DASHBOARD_PORT=8090
